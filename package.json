{
  "name": "x-for-agents",
  "version": "0.2.0",
  "description": "MCP server: let Claude browse X with your account in up to 10 parallel tabs and pull images, videos and posts fast, with token-lean output, contact sheets and a native gallery UI.",
  "type": "module",
  "bin": {
    "x-for-agents": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "scripts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "login": "node dist/index.js login",
    "doctor": "node dist/index.js doctor"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "^1.65.1",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "mcp",
    "claude",
    "claude-code",
    "x",
    "twitter",
    "scraper",
    "media-downloader",
    "playwright",
    "mcp-apps"
  ]
}
