{
  "name": "x-for-agents",
  "version": "0.1.0",
  "description": "MCP server that lets Claude Code browse X with your own logged-in account and extract images, videos and posts.",
  "type": "module",
  "bin": {
    "x-for-agents": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "login": "node dist/index.js login",
    "postinstall": "playwright install chromium || echo 'Run: npx playwright install chromium'"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "^1.65.1",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
