{
  "name": "riffler",
  "version": "0.3.0",
  "description": "Let Claude scroll X with your own account in ten tabs and keep the originals: full-size images, best-quality video and posts, straight into your repo. Free MCP server.",
  "type": "module",
  "bin": {
    "riffler": "dist/index.js",
    "x-for-agents": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "scripts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "login": "node dist/index.js login",
    "doctor": "node dist/index.js doctor"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "^1.65.1",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "riffler",
    "mcp",
    "mcp-server",
    "claude",
    "claude-code",
    "codex",
    "x",
    "twitter",
    "media-downloader",
    "playwright",
    "mcp-apps"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayhankhilji/x-for-agents.git"
  },
  "homepage": "https://github.com/rayhankhilji/x-for-agents#readme"
}
